{
  "name": "@countersign-ai/react",
  "version": "0.0.4",
  "description": "Drop-in approval inbox components for LangGraph human-in-the-loop agents",
  "keywords": [
    "langgraph",
    "langchain",
    "human-in-the-loop",
    "approval",
    "agents",
    "react"
  ],
  "homepage": "https://countersign.cloud",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/starkyru/countersign.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/starkyru/countersign/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:build": "storybook build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@types/react": "^19.3.0",
    "@types/react-test-renderer": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-test-renderer": "^19.3.1",
    "storybook": "^10.6.2",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
